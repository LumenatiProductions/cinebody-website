---
import Nav from '../components/Nav.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import footerHtml from '../fragments/_footer.html?raw';
import { hasOG, ogFileSlug } from '../og/entries';
import '../styles/global.css';

const {
  title,
  description = 'Cinebody is the video capture platform that turns your community into your content team. Direct authentic UGC at scale.',
  active,
  image = '/og.png',
  noindex = false,
  schema,   // optional page-specific JSON-LD (object or array), e.g. BlogPosting
} = Astro.props;

const siteName = 'Cinebody';
const fullTitle = title ? `${title} | ${siteName}` : `${siteName} | Real people film it. AI does the rest.`;
const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '') || Astro.site.href;
const slug = Astro.url.pathname.replace(/^\/+|\/+$/g, '');
// per-page branded share card where we generate one; otherwise the passed image (blog hero) or default
const ogImage = new URL(hasOG(slug) ? `/og/${ogFileSlug(slug)}.png` : image, Astro.site).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Cinebody',
  legalName: 'Super 6 LLC',
  url: 'https://www.cinebody.com',
  logo: 'https://www.cinebody.com/cinebody-icon.png',
  description,
  address: { '@type': 'PostalAddress', streetAddress: '3839 N Jackson Street', addressLocality: 'Denver', addressRegion: 'CO', postalCode: '80205', addressCountry: 'US' },
  email: 'info@cinebody.com',
  sameAs: ['https://vimeo.com/cinebody', 'https://instagram.com/cinebody', 'https://facebook.com/cinebody'],
};
const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Cinebody',
  url: 'https://www.cinebody.com',
};

const publisher = { '@type': 'Organization', name: 'Cinebody', url: 'https://www.cinebody.com' };
// Per-page entity schema, keyed by the nav `active` value.
const entitySchemas = {
  platform: {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Cinebody',
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Web',
    url: 'https://www.cinebody.com/platform',
    description:
      'An authentic video production platform: send a link and the AI writes the shotlist, coaches every filmer live on camera, scores each clip, and cuts a finished, on-brand video. Real people, run by AI.',
    offers: {
      '@type': 'Offer',
      priceCurrency: 'USD',
      price: '250',
      priceSpecification: { '@type': 'UnitPriceSpecification', price: '250', priceCurrency: 'USD', unitText: 'MONTH' },
      description: 'Software plans start at $250/month, billed annually.',
    },
    publisher,
  },
  services: {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Cinebody Creative Services',
    serviceType: 'Video creative services',
    url: 'https://www.cinebody.com/services',
    description:
      'Strategy, creative direction, and editing for community-captured video. Your content team without the headcount.',
    provider: publisher,
    areaServed: 'US',
  },
  pricing: {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Cinebody',
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Web',
    url: 'https://www.cinebody.com/pricing',
    description: 'Cinebody software plans plus optional Creative Services. Software starts at $250/month, billed annually.',
    offers: [
      { '@type': 'Offer', name: 'Plus', price: '250', priceCurrency: 'USD', description: 'For small teams. $250/month billed annually ($300 monthly).', url: 'https://www.cinebody.com/pricing' },
      { '@type': 'Offer', name: 'Pro', price: '500', priceCurrency: 'USD', description: 'For growing programs. $500/month billed annually ($600 monthly).', url: 'https://www.cinebody.com/pricing' },
      { '@type': 'Offer', name: 'Enterprise', priceCurrency: 'USD', description: 'Custom pricing for large organizations.', url: 'https://www.cinebody.com/pricing' },
    ],
    publisher,
  },
};

// Case studies: a CreativeWork per client, keyed by URL slug (they don't set `active`).
const caseStudies = {
  'royal-caribbean': ['Royal Caribbean', 'Turned onboard crew across the fleet into an always-on content engine, with no production crews flown in.'],
  'pointme': ['Point.me', 'One shoot produced a connected-TV spot plus a full multi-platform campaign featuring 70+ real customers.'],
  'nike': ['Nike', 'Captured authentic athlete and community video at the speed of culture.'],
  'dell': ['Dell', 'Scaled authentic employee and event video across teams and geographies.'],
  'georgia-pacific': ['Georgia-Pacific', 'Captured employee stories and brand video across a distributed workforce.'],
  'altra': ['Altra', 'Captured athlete stories on the trail and turned them into a season of content.'],
  'cogent': ['Cogent', 'Captured real festival and event footage and produced a marquee brand film.'],
  'crocs': ['Crocs', 'Ran a high-volume campaign of authentic creator and customer video.'],
  'sploot': ['Sploot', 'Shot once and produced a connected-TV spot plus a full set of social cutdowns.'],
};
let pageSchema = entitySchemas[active];
if (!pageSchema && caseStudies[slug]) {
  const [client, outcome] = caseStudies[slug];
  pageSchema = {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: `${client} × Cinebody`,
    headline: `${client} case study`,
    about: { '@type': 'Organization', name: client },
    description: outcome,
    creator: publisher,
    publisher,
    url: canonical,
  };
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Icons -->
    <link rel="icon" type="image/png" href="/cinebody-icon.png" />
    <link rel="apple-touch-icon" href="/cinebody-icon.png" />
    <meta name="theme-color" content="#0a0a0a" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Self-hosted variable font (no render-blocking third-party request) -->
    <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Vimeo player. Loaded deferred (after parse, before interaction) so it
         doesn't block render but is available globally for the page video
         scripts that several fragments rely on. -->
    <link rel="preconnect" href="https://player.vimeo.com" />
    <link rel="preconnect" href="https://i.vimeocdn.com" crossorigin />
    <script src="https://player.vimeo.com/api/player.js" defer></script>

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
    {pageSchema && <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />}
    {schema && [].concat(schema).map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a href="#content" class="skip-link">Skip to content</a>

    <Nav active={active} />

    <main id="content">
      <slot />
    </main>

    <Fragment set:html={footerHtml} />

    <!-- After fragment <style> tags so these beat page-level flex:1 / 1-col grids. -->
    <Fragment set:html={`<style>
      @media (max-width: 700px) {
        .hero-vid-pair, .vid-trio, .vert-trio, .vid-grid, .vid-grid-3v,
        .grid-2x2, .horiz-pair, .vert-pair, .vid-pair, .sparkle-pair, .sp-group, .tree-nodes {
          display: flex !important;
          flex-flow: row nowrap !important;
          grid-template-columns: none !important;
          justify-content: flex-start !important;
          align-items: stretch;
          max-width: none !important;
          width: 100% !important;
          gap: 14px !important;
          padding: 4px clamp(1.25rem, 12vw, 4rem) 8px !important;
          margin-left: -20px !important;
          margin-right: -20px !important;
        }
        .hero-vid-pair > *, .vid-trio > *, .vert-trio > *, .vid-grid > *, .vid-grid-3v > *,
        .grid-2x2 > *, .horiz-pair > *, .vert-pair > *, .vid-pair > *, .sparkle-pair > *,
        .sp-group > *, .tree-nodes > *, .cb-mcard {
          flex: 0 0 84% !important;
          width: 84% !important;
          max-width: 340px !important;
        }
      }
    </style>`} />

    <!-- Click-to-play / autoplay video controller for .vid-playable elements. -->
    <script is:inline>
      (function () {
        var playSVG = '<svg viewBox="0 0 24 24"><polygon points="5,3 19,12 5,21"/></svg>';
        var svgMuted = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 5L6 9H2v6h4l5 4V5z"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>';
        var svgUnmuted = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 5L6 9H2v6h4l5 4V5z"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>';

        var isMobile = window.innerWidth < 768;
        var isSafari = /^((?!chrome|android).)*safari/i.test(navigator.userAgent);
        var activePlayer = null, activeBtn = null;

        function loadVideo(container, videoId, hash) {
          if (container.classList.contains('playing')) return;
          var base = 'https://player.vimeo.com/video/' + videoId;
          var src = (hash ? base + '?h=' + hash + '&background=1' : base + '?background=1') + '&dnt=1';
          var iframe = document.createElement('iframe');
          iframe.src = src;
          iframe.allow = 'autoplay';
          iframe.loading = 'lazy';
          iframe.title = container.getAttribute('data-title') || 'Cinebody customer video';
          container.insertBefore(iframe, container.firstChild);
          container.classList.add('playing');
          if (window.Vimeo && Vimeo.Player) container._player = new Vimeo.Player(iframe);
        }

        // One mount routine for EVERY card — originals and the carousel's clones alike —
        // so play + mute behave identically everywhere. Exposed on window so the mobile
        // carousel can re-mount its clones through this exact path instead of a parallel one.
        function mountCard(container) {
          if (container.__cbMounted) return;
          var videoId = container.getAttribute('data-vimeo');
          var hash = container.getAttribute('data-vimeo-h');
          var autoplayDesktop = container.hasAttribute('data-autoplay');
          var autoplayAlways = container.hasAttribute('data-autoplay-always');
          if (!videoId) return;
          container.__cbMounted = true;

          var shouldAutoplay = !isSafari && !isMobile && (autoplayAlways || autoplayDesktop);

          var playBtn = document.createElement('div');
          playBtn.className = 'vid-play-btn';
          playBtn.innerHTML = playSVG;
          container.appendChild(playBtn);
          if (shouldAutoplay) {
            playBtn.style.opacity = '0';
            playBtn.style.pointerEvents = 'none';
          }

          var muteBtn = document.createElement('button');
          muteBtn.className = 'vid-mute-btn';
          muteBtn.innerHTML = svgMuted;
          muteBtn.setAttribute('aria-label', 'Unmute');
          container.appendChild(muteBtn);

          if (shouldAutoplay) {
            var obs = new IntersectionObserver(function (entries) {
              entries.forEach(function (e) {
                if (e.isIntersecting) { loadVideo(container, videoId, hash); obs.unobserve(container); }
              });
            }, { threshold: 0.15 });
            obs.observe(container);
          }

          container.addEventListener('click', function (e) {
            if (e.target.closest('.vid-mute-btn')) return;
            loadVideo(container, videoId, hash);
            playBtn.style.opacity = '0';
            playBtn.style.pointerEvents = 'none';
          });

          muteBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            var player = container._player;
            if (!player) return;
            if (activeBtn === muteBtn) {
              player.setVolume(0); muteBtn.innerHTML = svgMuted; muteBtn.setAttribute('aria-label', 'Unmute');
              activePlayer = null; activeBtn = null; return;
            }
            if (activePlayer && activeBtn) {
              activePlayer.setVolume(0); activeBtn.innerHTML = svgMuted; activeBtn.setAttribute('aria-label', 'Unmute');
            }
            player.setVolume(1); muteBtn.innerHTML = svgUnmuted; muteBtn.setAttribute('aria-label', 'Mute');
            activePlayer = player; activeBtn = muteBtn;
          });
        }

        window.__cbMountVideo = mountCard;
        document.querySelectorAll('.vid-playable').forEach(mountCard);
      })();
    </script>

    <!-- Homepage hero scroller: poster thumbnails carry the visual. On mobile or
         with reduced-motion we never stream the background videos at all; on
         desktop we only stream the cards currently in view and unload them once
         they scroll out, so the page never pulls tens of MB of video up front. -->
    <script is:inline>
      (function () {
        var iframes = Array.prototype.slice.call(document.querySelectorAll('.scr-card iframe[data-src]'));
        if (!iframes.length) return;
        // Stagger start times so no two cards show the same beat of their loops
        iframes.forEach(function (f, i) { f.dataset.t = (i % 5) * 6; });
        // Landscape clips letterbox in the portrait cards; tag them (via their
        // poster's natural aspect) so CSS can scale the player to cover instead
        iframes.forEach(function (f) {
          var img = f.parentElement.querySelector('img');
          if (!img) return;
          function chk() { if (img.naturalWidth > img.naturalHeight) f.parentElement.classList.add('scr-wide'); }
          if (img.complete) chk(); else img.addEventListener('load', chk);
        });
        var noVideo =
          window.matchMedia('(max-width: 767px)').matches ||
          window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
          !('IntersectionObserver' in window);
        if (noVideo) return;
        function withDnt(u) { return u + (u.indexOf('?') > -1 ? '&' : '?') + 'dnt=1'; }
        // Cap concurrent streams so the wall stays lively without pulling a dozen
        // Vimeo players at once; posters (real video frames) fill the rest.
        var MAX = 9, active = 0;
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            var f = e.target;
            if (e.isIntersecting) {
              if (!f.getAttribute('src') && active < MAX) { f.title = 'Cinebody customer video'; f.setAttribute('src', withDnt(f.dataset.src) + '#t=' + f.dataset.t + 's'); active++; }
            } else if (f.getAttribute('src')) {
              f.removeAttribute('src'); active = Math.max(0, active - 1); // revert to poster, stop the stream
            }
          });
        }, { threshold: 0.2 });
        var idle = window.requestIdleCallback || function (cb) { return setTimeout(cb, 300); };
        idle(function () { iframes.forEach(function (f) { io.observe(f); }); });
      })();
    </script>

    <!-- Vercel Web Analytics + Speed Insights -->
    <Analytics />
    <SpeedInsights />
  <script is:inline>
// App AI ring on CTAs sitewide (exact port from the web app's AiPillRing)
(function(){
  function build(){
    var TEAL='rgb(0,188,241)', YEL='rgb(255,236,3)', PINK='rgb(235,0,139)';
    var B1=['rgb(16,191,226)','rgb(52,198,192)','rgb(101,207,147)','rgb(154,217,97)','rgb(203,226,52)','rgb(239,233,18)'];
    var B2=['rgb(254,221,12)','rgb(251,187,31)','rgb(247,142,57)','rgb(243,94,85)','rgb(239,49,111)','rgb(236,15,130)'];
    var B3=['rgb(220,12,145)','rgb(187,39,160)','rgb(142,75,179)','rgb(93,113,201)','rgb(48,149,220)','rgb(15,176,235)'];
    var colors=[]; var i;
    for(i=0;i<9;i++)colors.push(TEAL);
    colors=colors.concat(B1);
    for(i=0;i<18;i++)colors.push(YEL);
    colors=colors.concat(B2);
    for(i=0;i<18;i++)colors.push(PINK);
    colors=colors.concat(B3);
    for(i=0;i<9;i++)colors.push(TEAL);
    var NS='http://www.w3.org/2000/svg', LAP=700;
    document.querySelectorAll('.btn-glow, .site-nav__cta').forEach(function(btn){
      if(btn.closest('.cta-band'))return; // yellow bands: plain black pill, no ring
      if(btn.querySelector('.ai-ring'))return;
      var svg=document.createElementNS(NS,'svg');
      svg.setAttribute('class','ai-ring');
      svg.setAttribute('aria-hidden','true');
      colors.forEach(function(c,idx){
        var r=document.createElementNS(NS,'rect');
        r.setAttribute('pathLength','3');
        r.setAttribute('stroke',c);
        r.style.setProperty('--o',String(-(idx*3/colors.length)));
        svg.appendChild(r);
      });
      btn.appendChild(svg);
      btn.addEventListener('mouseenter',function(){
        if(window.matchMedia('(prefers-reduced-motion: reduce)').matches)return;
        svg.querySelectorAll('rect').forEach(function(r){
          if(r.getAnimations&&r.getAnimations().length)return;
          var base=parseFloat(getComputedStyle(r).getPropertyValue('--o'))||0;
          r.animate([{strokeDashoffset:base},{strokeDashoffset:base-3}],{duration:LAP,easing:'ease-in-out'});
        });
      });
    });
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',build);
  else build();
})();
</script>
<script>
// ── Infinite carousel for the mobile video sliders ──────────────────────────
// Replaces native horizontal scroll with a transform-driven track that RECYCLES
// its own children (moves the item that leaves one edge to the other edge and
// compensates the transform), so it wraps forever in both directions. No clones,
// so every card keeps the click-to-play handler the video controller already bound.
// Mobile only; on desktop these render as static grids and this never runs. If the
// script is disabled the CSS native-scroll version still works as a fallback.
(function () {
  if (!window.matchMedia('(max-width: 700px)').matches) return;
  var SEL = '.pipe-outputs, .hero-vid-pair, .vid-trio, .vert-trio, .vid-grid, .vid-grid-3v, .grid-2x2, .horiz-pair, .vert-pair, .vid-pair, .sparkle-pair, .sp-group, .tree-nodes';

  // cloneNode copies the controller's play/mute buttons but NOT their listeners, so a
  // fresh clone has dead controls. Strip the cloned-in state and re-mount the clone
  // through the SAME controller the originals use, so play + mute are identical on
  // every card in the loop (fixes mute doing nothing on the cloned cards).
  function wirePlay(node) {
    var v = node.matches && node.matches('.vid-playable') ? node : (node.querySelector && node.querySelector('.vid-playable'));
    if (!v) return;
    v.classList.remove('playing');
    var old = v.querySelector('iframe'); if (old) old.remove();
    var pb = v.querySelector('.vid-play-btn'); if (pb) pb.remove();
    var mb = v.querySelector('.vid-mute-btn'); if (mb) mb.remove();
    v._player = null; v.__cbMounted = false;
    if (window.__cbMountVideo) window.__cbMountVideo(v);
  }

  function setup(track) {
    var items = Array.prototype.slice.call(track.children);
    if (items.length < 2) return;
    Array.prototype.forEach.call(track.querySelectorAll('img'), function (i) { i.draggable = false; });

    // Force a flex row BEFORE wrapping. Fragment CSS uses flex:1 / 1-col grids,
    // which shrink 3-up rows to fit the viewport and make the infinite carousel
    // look like a static cramped grid.
    track.style.display = 'flex';
    track.style.flexFlow = 'row nowrap';
    track.style.justifyContent = 'flex-start';
    track.style.maxWidth = 'none';
    track.style.width = '100%';
    if (!track.style.gap) track.style.gap = '14px';

    // Wrap the track in a clipping viewport; move the edge-bleed + peek padding onto it.
    var cs = getComputedStyle(track);
    // Pin the viewport to the parent's width *before* clones exist. Grid/flex
    // items have min-width:auto, so an unpinned vp grows with the cloned strip
    // and the row stops looking like a one-card scroller.
    var parentW = track.parentElement ? track.parentElement.clientWidth : window.innerWidth;
    var widthCss = 'width:' + parentW + 'px;max-width:100%;';
    var vp = document.createElement('div');
    vp.className = 'cb-vp';
    vp.style.cssText = 'position:relative;overflow:hidden;touch-action:pan-y;cursor:grab;min-width:0;box-sizing:border-box;' + widthCss +
      'margin-left:' + cs.marginLeft + ';margin-right:' + cs.marginRight + ';' +
      'padding-left:' + cs.paddingLeft + ';padding-right:' + cs.paddingRight + ';';
    track.parentNode.insertBefore(vp, track);
    vp.appendChild(track);
    track.classList.add('cb-tr');
    var gap = parseFloat(cs.columnGap || cs.gap) || 0;

    // Pixel lock after the viewport exists. %-basis on a nowrap track is cyclic
    // once clones are added (84% of a content-sized track ≠ 84% of the screen),
    // which shrank the working hero to ~170px. 84% of the visible vp, cap 340.
    if (!track.classList.contains('pipe-outputs')) {
      var cardPx = Math.min(340, Math.max(160, Math.round(window.innerWidth * 0.84)));
      items.forEach(function (it) {
        it.classList.add('cb-mcard');
        it.style.setProperty('flex', '0 0 ' + cardPx + 'px', 'important');
        it.style.setProperty('width', cardPx + 'px', 'important');
        it.style.setProperty('max-width', 'none', 'important');
      });
    }
    track.style.overflow = 'visible';
    track.style.margin = '0';
    track.style.padding = '0';
    track.style.position = 'relative';
    track.style.scrollSnapType = 'none';
    track.style.willChange = 'transform';
    track.style.transform = 'translate3d(0,0,0)';
    // The carousel's own transform overrides the scroll-reveal transform, and the
    // reveal observer won't fire on the wrapped track — so resolve it to visible now,
    // else opacity stays 0 and the whole slider is invisible.
    track.classList.add('vis'); track.style.opacity = '1';

    // Uniform card width → one period P and one full-set width setW. Duplicate the set
    // as WHOLE copies so the DOM is FIXED. We wrap by teleporting the transform one
    // set-width at a seam (identical sets = invisible jump) and never touch the DOM
    // mid-drag — so scrolling is smooth and the play/mute buttons don't jitter.
    void track.offsetWidth;
    var N = items.length;
    var P = items[0].getBoundingClientRect().width + gap;
    var setW = N * P;
    var sets = Math.max(3, Math.ceil((Math.ceil(vp.clientWidth / P) + 3) / N));
    for (var si = 1; si < sets; si++) {
      items.forEach(function (it) {
        var c = it.cloneNode(true);
        Array.prototype.forEach.call(c.querySelectorAll('img'), function (i) { i.draggable = false; });
        wirePlay(c);
        track.appendChild(c);
      });
    }

    var pos = 0;
    function apply() { track.style.transform = 'translate3d(' + pos + 'px,0,0)'; }
    // Teleport-wrap: keep pos inside one set-width band. Pure math + transform, no DOM.
    function wrap() {
      var guard = 0;
      while (pos <= -2 * setW && guard++ < 999) pos += setW;
      guard = 0;
      while (pos > -setW && guard++ < 999) pos -= setW;
      apply();
    }

    // Center the nearest item in the viewport.
    function nearest() {
      var v = vp.getBoundingClientRect(), mid = v.left + v.width / 2, best = null, bd = Infinity;
      Array.prototype.forEach.call(track.children, function (it) {
        var r = it.getBoundingClientRect(), c = r.left + r.width / 2, d = Math.abs(c - mid);
        if (d < bd) { bd = d; best = it; }
      });
      return best;
    }
    function snap() {
      var it = nearest(); if (!it) return;
      var v = vp.getBoundingClientRect(), r = it.getBoundingClientRect();
      animateBy((v.left + v.width / 2) - (r.left + r.width / 2));
    }
    var raf = 0;
    function animateBy(delta) {
      cancelAnimationFrame(raf);
      var start = pos, target = pos + delta, t0 = 0;
      function step(t) {
        if (!t0) t0 = t;
        var k = Math.min(1, (t - t0) / 320), e = 1 - Math.pow(1 - k, 3);
        pos = start + (target - start) * e; apply();
        if (k < 1) raf = requestAnimationFrame(step); else wrap();
      }
      raf = requestAnimationFrame(step);
    }

    // Initial layout: center the first card, then wrap to fill both edges.
    (function initPos() {
      var v = vp.getBoundingClientRect(), r = track.firstElementChild.getBoundingClientRect();
      pos = (v.left + v.width / 2) - (r.left + r.width / 2); wrap();
    })();
    window.addEventListener('resize', function () { wrap(); snap(); });

    // ── pointer drag + momentum + direction lock ──
    var down = false, dragging = false, decided = false, ignore = false;
    var sx = 0, sy = 0, sp = 0, lastX = 0, lastT = 0, vel = 0, moved = 0, pid = null;
    vp.addEventListener('pointerdown', function (e) {
      if (e.button != null && e.button !== 0) return;
      cancelAnimationFrame(raf);
      down = true; dragging = false; decided = false; ignore = false; moved = 0;
      sx = lastX = e.clientX; sy = e.clientY; sp = pos; lastT = e.timeStamp || performance.now(); vel = 0; pid = e.pointerId;
    });
    vp.addEventListener('pointermove', function (e) {
      if (!down || ignore) return;
      var dx = e.clientX - sx, dy = e.clientY - sy;
      if (!decided) {
        if (Math.abs(dx) < 4 && Math.abs(dy) < 4) return;
        decided = true;
        if (Math.abs(dy) > Math.abs(dx)) { ignore = true; return; }  // vertical → let the page scroll
        dragging = true; vp.style.cursor = 'grabbing';
        try { vp.setPointerCapture(pid); } catch (_) {}
      }
      if (!dragging) return;
      moved = Math.max(moved, Math.abs(dx));
      pos = sp + dx; apply(); wrap();
      var now = e.timeStamp || performance.now(), dt = now - lastT;
      if (dt > 0) { var v2 = (e.clientX - lastX) / dt; vel = Math.max(-4, Math.min(4, v2)); }  // px/ms, clamped
      lastX = e.clientX; lastT = now;
      e.preventDefault();
    });
    function up() {
      if (!down) return; down = false; vp.style.cursor = 'grab';
      try { vp.releasePointerCapture(pid); } catch (_) {}
      if (moved > 6) {                              // was a drag: swallow the click so no video opens
        var kill = function (ev) { ev.stopPropagation(); ev.preventDefault(); vp.removeEventListener('click', kill, true); };
        vp.addEventListener('click', kill, true);
        setTimeout(function () { vp.removeEventListener('click', kill, true); }, 60);
      }
      if (!dragging) return;
      dragging = false;
      var v = vel * 16;                             // carry momentum
      cancelAnimationFrame(raf);
      (function glide() {
        v *= 0.93;
        if (Math.abs(v) < 0.4) { snap(); return; }
        pos += v; apply(); wrap();
        raf = requestAnimationFrame(glide);
      })();
    }
    vp.addEventListener('pointerup', up);
    vp.addEventListener('pointercancel', up);
  }

  // Set up each slider only once it actually has a real on-screen width.
  // Hidden tab panels measure 0 at load; a too-early setup (parent ~0) pins a
  // 0-width viewport and the row looks empty / refuses to swipe. Wait until
  // both the track and its parent are at least 200px, then init.
  function ready(track) {
    var w = track.getBoundingClientRect().width;
    var pw = track.parentElement ? track.parentElement.clientWidth : 0;
    return w >= 200 && pw >= 200;
  }
  function arm(track) {
    if (track.dataset.cbInit) return;
    if (ready(track)) { track.dataset.cbInit = '1'; setup(track); return; }
    if (typeof ResizeObserver === 'undefined') { track.dataset.cbInit = '1'; setup(track); return; }
    var ro = new ResizeObserver(function () {
      if (!track.dataset.cbInit && ready(track)) {
        track.dataset.cbInit = '1'; ro.disconnect(); setup(track);
      }
    });
    ro.observe(track);
    if (track.parentElement) ro.observe(track.parentElement);
  }
  window.__cbArmCarousel = arm;
  function init() { document.querySelectorAll(SEL).forEach(arm); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
})();
</script>
</body>
</html>
