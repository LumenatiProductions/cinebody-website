---
// Rebuilt site navigation (Squarespace provided this natively before).
// `active` matches a nav item key to flag the current page.
const { active } = Astro.props;

const caseStudies = [
  { label: 'Royal Caribbean', href: '/royal-caribbean' },
  { label: 'Point.me', href: '/pointme' },
  { label: 'Nike', href: '/nike' },
  { label: 'Dell', href: '/dell' },
  { label: 'Georgia-Pacific', href: '/georgia-pacific' },
  { label: 'Altra', href: '/altra' },
  { label: 'Cogent', href: '/cogent' },
  { label: 'Crocs', href: '/crocs' },
  { label: 'Sploot', href: '/sploot' },
];
const csKeys = caseStudies.map((c) => c.href.slice(1));
const workActive = active === 'work' || csKeys.includes(active);
const resourcesActive = ['blog', 'knowledge-base'].includes(active);

const LOGIN_URL = 'https://pro.cinebody.com/login';
const DEMO_URL = 'https://calendly.com/gavin-cinebody/cinebody-intro2';
const LOGO = '/assets/5b29f7e3-cb_white.png';
---

<nav class="site-nav" id="siteNav" aria-label="Primary">
  <div class="site-nav__inner">
    <a class="site-nav__logo" href="/" aria-label="Cinebody home">
      <img src={LOGO} alt="Cinebody" width="110" height="22" />
    </a>

    <button
      class="site-nav__toggle"
      id="navToggle"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="navMenu"
    >
      <span></span><span></span><span></span>
    </button>

    <div class="site-nav__menu" id="navMenu">
      <ul class="site-nav__links">
        <li><a href="/platform" aria-current={active === 'platform' ? 'page' : undefined}>Platform</a></li>

        <li><a href="/services" aria-current={active === 'services' ? 'page' : undefined}>Services</a></li>

        <li class="site-nav__item--menu">
          <button
            class="site-nav__disclosure"
            aria-expanded="false"
            aria-haspopup="true"
            aria-current={workActive ? 'page' : undefined}
          >
            Work
            <svg class="site-nav__chev" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div class="site-nav__dropdown" role="menu">
            <span class="site-nav__dropdown-label">Case Studies</span>
            <div class="site-nav__dropdown-grid">
              <a href="/work" role="menuitem" aria-current={active === 'work' ? 'page' : undefined}>All Work</a>
              {caseStudies.map((c) => (
                <a href={c.href} role="menuitem" aria-current={active === c.href.slice(1) ? 'page' : undefined}>{c.label}</a>
              ))}
            </div>
          </div>
        </li>
        <li><a href="/pricing" aria-current={active === 'pricing' ? 'page' : undefined}>Pricing</a></li>

        <li class="site-nav__item--menu">
          <button
            class="site-nav__disclosure"
            aria-expanded="false"
            aria-haspopup="true"
            aria-current={resourcesActive ? 'page' : undefined}
          >
            Resources
            <svg class="site-nav__chev" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div class="site-nav__dropdown site-nav__dropdown--narrow" role="menu">
            <span class="site-nav__dropdown-label">Resources</span>
            <div class="site-nav__dropdown-grid site-nav__dropdown-grid--stack">
              <a href="/cinebody-blog" role="menuitem" aria-current={active === 'blog' ? 'page' : undefined}>Blog</a>
              <a href="/knowledge-base" role="menuitem" aria-current={active === 'knowledge-base' ? 'page' : undefined}>Knowledge Base</a>
            </div>
          </div>
        </li>
      </ul>
      <div class="site-nav__actions">
        <a class="site-nav__login" href={LOGIN_URL}>Log in</a>
        <a class="site-nav__cta" href={DEMO_URL}>Book a Demo</a>
      </div>
      <div class="site-nav__apps">
        <span class="site-nav__apps-label">Get the app</span>
        <div class="store-badges">
          <a href="#" class="store-badge" aria-label="Download on the App Store"><svg viewBox="0 0 120 40" role="img" xmlns="http://www.w3.org/2000/svg"><rect x="0.5" y="0.5" width="119" height="39" rx="7.5" fill="#000" stroke="rgba(255,255,255,0.28)"/><g transform="translate(10,9.5) scale(0.85)"><path fill="#fff" d="M16.365 1.43c0 1.14-.493 2.27-1.177 3.08-.744.9-1.99 1.57-2.987 1.57-.12 0-.23-.02-.3-.03-.01-.06-.04-.22-.04-.39 0-1.15.572-2.27 1.206-2.98.804-.94 2.142-1.64 3.248-1.68.03.13.05.28.05.43zm4.565 15.71c-.03.07-.463 1.58-1.518 3.12-.945 1.34-1.94 2.71-3.43 2.71-1.517 0-1.9-.88-3.63-.88-1.698 0-2.302.91-3.67.91-1.377 0-2.332-1.26-3.428-2.8-1.287-1.82-2.323-4.63-2.323-7.28 0-4.28 2.797-6.55 5.552-6.55 1.448 0 2.675.95 3.6.95.865 0 2.222-1.01 3.902-1.01.613 0 2.886.06 4.374 2.19-.13.09-2.383 1.37-2.383 4.19 0 3.26 2.854 4.42 2.955 4.45z"/></g><text x="37" y="16.5" fill="#fff" font-family="'Helvetica Neue',Arial,sans-serif" font-size="6.5" letter-spacing="0.3">Download on the</text><text x="36.5" y="30" fill="#fff" font-family="'Helvetica Neue',Arial,sans-serif" font-size="15" font-weight="500" letter-spacing="-0.4">App Store</text></svg></a>
          <a href="#" class="store-badge" aria-label="Get it on Google Play"><svg viewBox="0 0 135 40" role="img" xmlns="http://www.w3.org/2000/svg"><rect x="0.5" y="0.5" width="134" height="39" rx="7.5" fill="#000" stroke="rgba(255,255,255,0.28)"/><g transform="translate(11,11)"><path d="M0 0 L0 18 L3.6 9 Z" fill="#00e676"/><path d="M0 0 L3.6 9 L15.6 9 Z" fill="#00c3ff"/><path d="M3.6 9 L0 18 L15.6 9 Z" fill="#ff3d47"/><path d="M11.9 7.4 L15.6 9 L11.9 10.6 Z" fill="#ffce00"/></g><text x="37" y="16.5" fill="#fff" font-family="'Helvetica Neue',Arial,sans-serif" font-size="6" letter-spacing="1">GET IT ON</text><text x="36.5" y="30" fill="#fff" font-family="'Helvetica Neue',Arial,sans-serif" font-size="15" font-weight="500" letter-spacing="-0.3">Google Play</text></svg></a>
        </div>
      </div>
    </div>
  </div>
</nav>

<script is:inline>
  (function () {
    var nav = document.getElementById('siteNav');
    var toggle = document.getElementById('navToggle');
    if (!nav || !toggle) return;

    function closeMenu() {
      nav.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    // Glass-dark on scroll
    var onScroll = function () {
      if (window.pageYOffset > 24) nav.classList.add('shrink');
      else nav.classList.remove('shrink');
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // Mobile menu
    toggle.addEventListener('click', function () {
      var open = nav.classList.toggle('open');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      document.body.style.overflow = open ? 'hidden' : '';
    });

    // Disclosures (Work, Resources) — click toggles; CSS handles desktop hover/focus
    var disclosures = Array.prototype.slice.call(nav.querySelectorAll('.site-nav__disclosure'));
    function closeDisclosures(except) {
      disclosures.forEach(function (d) {
        if (d !== except) d.setAttribute('aria-expanded', 'false');
      });
    }
    disclosures.forEach(function (disclosure) {
      disclosure.addEventListener('click', function (e) {
        e.preventDefault();
        var open = disclosure.getAttribute('aria-expanded') === 'true';
        closeDisclosures(disclosure);
        disclosure.setAttribute('aria-expanded', open ? 'false' : 'true');
      });
    });

    // Close everything when a link is tapped
    nav.querySelectorAll('.site-nav__menu a').forEach(function (a) {
      a.addEventListener('click', function () {
        closeDisclosures();
        closeMenu();
      });
    });

    // Close on outside click (desktop dropdown)
    document.addEventListener('click', function (e) {
      if (!e.target.closest('.site-nav__item--menu')) {
        closeDisclosures();
      }
    });

    // Close on Escape
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      closeDisclosures();
      if (nav.classList.contains('open')) closeMenu();
    });
  })();
</script>
